{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Statslock Companion",
  "version": "0.1.3",
  "identifier": "io.statslock.companion",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Statslock Companion",
        "width": 420,
        "height": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src https://statslock.io; img-src 'self' https: data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNTFBNURBM0YxREFCOTAKUldTUXF4MC8ycVZSekpRU283Ni9yQ2lZcXlncnNlUXFUV0dadXc2Ly8yT1g2anNPOVlLc2dNUTcK",
      "endpoints": ["https://github.com/Nordstrm/statslock-companion/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
